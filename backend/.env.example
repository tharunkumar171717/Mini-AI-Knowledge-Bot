# Supabase Postgres with pgvector: Project Settings -> Database -> Connection string (session pooler, port 5432).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Reads scanned PDF pages and images
OCR_MODEL=gemini-3.5-flash-lite

EMBEDDING_MODEL=gemini-embedding-001
MAX_UPLOAD_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:5174"]
